# Settings the server needs. On the server, these go in a private file
# that is never committed to GitHub. Replace every placeholder.
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=mysql+pymysql://DB_USER:DB_PASSWORD@DB_ENDPOINT:3306/securedesk
S3_MEDIA_BUCKET=securedesk-media-yoursuffix
S3_BACKUP_BUCKET=securedesk-backups-yoursuffix
AWS_REGION=ap-south-1
PROXY_COUNT=1